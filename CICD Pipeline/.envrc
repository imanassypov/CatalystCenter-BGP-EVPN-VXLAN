# Auto-load lab credentials when you: cd into "CICD Pipeline"
# One-time setup: direnv allow   (from this directory)

dotenv_if_exists .env

# macOS only: Ansible forks worker processes, and any Objective-C runtime
# initialised in the parent (CoreFoundation proxy/DNS lookups made by the
# catalystcenter SDK) aborts the child -> "A worker was found in a dead state".
if [ "$(uname -s)" = "Darwin" ]; then
  export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
  export no_proxy='*'
fi
